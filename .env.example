# Postgres. On Neon use the pooled URL (with ?pgbouncer=true&connection_limit=1) for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL, which Prisma uses for migrations.
DATABASE_URL="postgresql://relay:relay@localhost:5433/relay"
DIRECT_URL="postgresql://relay:relay@localhost:5433/relay"
# Used only by `npm test`. Created automatically by docker-compose.
TEST_DATABASE_URL="postgresql://relay:relay@localhost:5433/relay_test"

# Auth.js session signing key: `npx auth secret` or any random 32+ byte string.
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` automatically when this is set in the project.
CRON_SECRET="change-me"

# Optional. Without a key the app ranks riders with the deterministic scorer only.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
AI_TIMEOUT_MS=8000

# Shows demo accounts on the login page.
DEMO_MODE=true
# Enables POST /api/admin/seed (ADMIN only). Turn off in production after seeding.
ALLOW_SEED=false
